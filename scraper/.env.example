# ============================================================================
# Конфигурация парсера mc.ru (МЕТАЛЛСЕРВИС, филиал Санкт-Петербург)
# Скопируйте в .env и при необходимости отредактируйте.
# ============================================================================

# --- База данных ---
# Тот же PostgreSQL, что использует сайт (Prisma). Порт 5433 — хостовый маппинг
# из docker-compose.yml проекта. Внутри Docker-сети парсера используйте host=db:5432.
DATABASE_URL=postgresql://metal:metal@localhost:5433/metalshop

# --- Движок загрузки ---
# curl_cffi  — основной (имперсонирует TLS-фингерпринт Chrome, обходит фильтр mc.ru).
# playwright — гарантированный фолбэк (chromium headless), импортируется лениво.
SCRAPER_ENGINE=curl_cffi

# Профиль имперсонации для curl_cffi (chrome | chrome110 | chrome120 | safari ...).
# Парсер всё равно перебирает несколько профилей; это лишь стартовый.
IMPERSONATE=chrome

# --- Источник ---
BASE_URL=https://mc.ru
REGION=speterburg

# --- НДС ---
# Включает ли цена-источник НДС. Для металлоторговли РФ по умолчанию true.
# ПРОВЕРИТЬ на живой странице mc.ru и при необходимости переключить.
PRICE_INCLUDES_VAT=true

# --- Поведение обхода ---
REQUEST_DELAY=1.5            # пауза между запросами, сек (троттлинг, вежливость)
MAX_PAGES_PER_CATEGORY=50    # предел страниц пагинации на категорию
REQUEST_TIMEOUT=30           # таймаут одного HTTP-запроса, сек

# --- Прокси (опционально, для фолбэка через RU-IP) ---
# Если заданы — curl_cffi пойдёт через них. Полезно при датацентровом IP.
# HTTP_PROXY=http://user:pass@ru-proxy-host:port
# HTTPS_PROXY=http://user:pass@ru-proxy-host:port

# --- Логирование ---
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Дефолтная наценка (фолбэк, если в Setting нет ключа default_markup_percent) ---
DEFAULT_MARKUP_PERCENT=10
