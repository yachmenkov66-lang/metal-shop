# ====== ПРОДАКШН (docker-compose.prod.yml) ======
# Скопируйте в `.env` рядом с docker-compose.prod.yml и заполните своими значениями.

# Пароль БД Postgres (придумайте сложный)
DB_PASSWORD=change_me_to_strong_password

# Секрет для подписи сессий — ОБЯЗАТЕЛЬНО смените (минимум 32 случайных символа).
# Сгенерировать: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars

# Наценка по умолчанию, % (если не задана на категорию/товар)
DEFAULT_MARKUP_PERCENT=10

# Внешний порт веб-приложения (обычно за reverse-proxy nginx)
WEB_PORT=3000

# ====== Парсер mc.ru ======
# Движок запросов: curl_cffi (по умолчанию, обходит TLS-фильтр) или playwright (фолбэк)
SCRAPER_ENGINE=curl_cffi
# Включает ли цена-источник НДС (проверить на живой странице)
PRICE_INCLUDES_VAT=true
LOG_LEVEL=INFO

# ====== ЛОКАЛЬНАЯ РАЗРАБОТКА ======
# Для `npm run dev` используется отдельный файл `.env` со строкой подключения к локальной БД:
# DATABASE_URL="postgresql://metal:metal@localhost:5433/metalshop?schema=public"
# JWT_SECRET="dev-only-secret"
